# App
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
GITHUB_CLIENT_ID=replace-with-github-oauth-client-id
GITHUB_CLIENT_SECRET=replace-with-github-oauth-client-secret
NEXT_PUBLIC_APP_TITLE=leet-review

# Database
# Local development defaults to SQLite.
DATABASE_MODE=local
LOCAL_SQLITE_PATH=data/dev.sqlite

# Remote D1 mode
# Set DATABASE_MODE=d1-http to use these at runtime and in Drizzle Kit.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_DATABASE_ID=
CLOUDFLARE_D1_TOKEN=

# Daily LeetCode refresh (Vercel cron -> /api/cron/leetcode)
# CRON_SECRET is sent by Vercel as an Authorization bearer token. At least 16 chars.
CRON_SECRET=
# Deploy hook URL from Project Settings -> Git -> Deploy Hooks. The cron job
# POSTs it to rebuild, which regenerates data/leetcode-cache.json at build time.
# Leave unset locally: the rebuild step is then skipped.
VERCEL_DEPLOY_HOOK_URL=

# Optional
LEETCODE_CACHE_PATH=data/leetcode-cache.json
NEETCODE_CACHE_PATH=data/neetcode-cache.json
# Set to 1 to keep the committed index and skip the fetch during `bun run build`.
LEETCODE_SKIP_INDEX_REFRESH=
