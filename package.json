{
  "name": "leet-review",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "next dev",
    "build": "tsx scripts/populate-leetcode-cache.ts || true && next build",
    "start": "next start",
    "preview": "next build && next start",
    "test": "vitest run",
    "format": "biome format --write",
    "lint": "biome lint",
    "check": "biome check",
    "auth:generate": "pnpm dlx @better-auth/cli@latest generate --config src/lib/auth.ts --output src/db/auth.schema.ts -y",
    "auth:migrate": "pnpm dlx @better-auth/cli@latest migrate --config src/lib/auth.ts -y",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:studio": "drizzle-kit studio",
    "neetcode:cache": "tsx scripts/populate-neetcode-cache.ts",
    "leetcode:cache": "tsx scripts/populate-leetcode-cache.ts",
    "db:migrate:r": "wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@t3-oss/env-core": "0.13.10",
    "@tanstack/react-devtools": "^0.10.2",
    "@tanstack/react-hotkeys": "^0.9.1",
    "@tanstack/react-hotkeys-devtools": "^0.6.6",
    "@tanstack/react-query": "5.90.21",
    "@tanstack/react-table": "8.21.3",
    "better-auth": "1.4.18",
    "better-sqlite3": "12.6.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "drizzle-kit": "0.31.9",
    "drizzle-orm": "0.45.1",
    "lucide-react": "0.575.0",
    "nanoid": "3.3.11",
    "next": "16.2.1",
    "nuqs": "2.8.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-icons": "5.5.0",
    "tailwind-merge": "3.5.0",
    "tailwindcss": "4.2.0",
    "ts-fsrs": "5.2.3",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "@tailwindcss/postcss": "4.2.2",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.19.11",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "agentation": "^3.0.2",
    "dotenv": "16.6.1",
    "jsdom": "27.4.0",
    "shadcn": "3.8.5",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "3.2.4",
    "wrangler": "^4.86.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "sharp",
      "workerd"
    ]
  }
}
